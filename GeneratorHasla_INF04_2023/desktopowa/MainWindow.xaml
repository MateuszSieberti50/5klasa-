<Window x:Class="GeneratorHasla.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dodaj pracownika - Wykonał Mateusz Golnau" 
        Height="420" Width="680"
        Background="#B0C4DE"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Górna sekcja 2 kolumny: Dane pracownika i Generowanie hasła -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Grupa Dane pracownika -->
            <GroupBox Header="Dane pracownika" Grid.Column="0" Margin="0,0,10,0" Padding="10" Foreground="Black" FontSize="14">
                <StackPanel VerticalAlignment="Center">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Imię" VerticalAlignment="Center" FontSize="14"/>
                        <TextBox x:Name="TxtImie" Grid.Column="1" Padding="4" FontSize="14"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Nazwisko" VerticalAlignment="Center" FontSize="14"/>
                        <TextBox x:Name="TxtNazwisko" Grid.Column="1" Padding="4" FontSize="14"/>
                    </Grid>

                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Stanowisko" VerticalAlignment="Center" FontSize="14"/>
                        <ComboBox x:Name="CmbStanowisko" Grid.Column="1" SelectedIndex="0" Padding="4" FontSize="14">
                            <ComboBoxItem Content="Kierownik"/>
                            <ComboBoxItem Content="Starszy programista"/>
                            <ComboBoxItem Content="Młodszy programista"/>
                            <ComboBoxItem Content="Tester"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- Grupa Generowanie hasła -->
            <GroupBox Header="Generowanie hasła" Grid.Column="1" Margin="10,0,0,0" Padding="10" Foreground="Black" FontSize="14">
                <StackPanel VerticalAlignment="Center">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Ile znaków?" VerticalAlignment="Center" FontSize="14"/>
                        <TextBox x:Name="TxtIleZnakow" Grid.Column="1" Padding="4" FontSize="14"/>
                    </Grid>

                    <CheckBox x:Name="ChkLitery" Content="Małe i wielkie litery" IsChecked="True" Margin="0,0,0,8" FontSize="14"/>
                    <CheckBox x:Name="ChkCyfry" Content="Cyfry" Margin="0,0,0,8" FontSize="14"/>
                    <CheckBox x:Name="ChkZnaki" Content="Znaki specjalne" Margin="0,0,0,15" FontSize="14"/>

                    <Button x:Name="BtnGenerujHaslo" Content="Generuj hasło" Background="#4682B4" Foreground="White" FontWeight="Bold" Padding="15,6" HorizontalAlignment="Center" BorderThickness="0" Click="BtnGenerujHaslo_Click"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- Dolny przycisk Zatwierdź (dłuższy niż Generuj hasło) -->
        <Button x:Name="BtnZatwierdz" Grid.Row="1" Content="Zatwierdź" Background="#4682B4" Foreground="White" FontWeight="Bold" FontSize="14" Padding="100,8" HorizontalAlignment="Center" BorderThickness="0" Click="BtnZatwierdz_Click"/>
    </Grid>
</Window>
