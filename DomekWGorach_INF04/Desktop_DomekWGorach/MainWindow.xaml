<Window x:Class="DomekWGorach.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Domek w górach - Wykonał Mateusz Golnau" 
        Height="550" Width="400"
        Background="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,20,0,0">
            <TextBlock Text="Domek w górach" FontSize="26" FontWeight="Normal" Margin="15,0,15,10" Foreground="Black"/>

            <Border Height="180" Background="#A9A9A9" Margin="0,0,0,0">
                <TextBlock Text="[ Obraz: obraz.jpg ]" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="16" FontWeight="Bold"/>
            </Border>

            <Grid Background="#008080" Height="45">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnPolub" Grid.Column="0" Content="POLUB" Background="Transparent" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="14" Click="BtnPolub_Click"/>
                <Button x:Name="BtnUsun" Grid.Column="1" Content="USUŃ" Background="Transparent" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="14" Click="BtnUsun_Click"/>
                <Button x:Name="BtnZapisz" Grid.Column="2" Content="ZAPISZ" Background="Transparent" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="14" Click="BtnZapisz_Click"/>
            </Grid>

            <TextBlock x:Name="TxtPolubienia" Text="0 polubień" HorizontalAlignment="Right" FontSize="14" Margin="15,10,15,10" Foreground="Black"/>

            <Rectangle Height="1" Fill="#808080" Margin="15,0,15,15"/>

            <TextBlock Text="Opis" FontSize="16" FontWeight="Bold" Margin="15,0,15,5" Foreground="Black"/>

            <TextBlock Text="Odwiedź komfortowy domek w Sudetach, blisko do szlaków turystycznych" FontSize="14" Foreground="#808080" TextWrapping="Wrap" Margin="15,0,15,15"/>
        </StackPanel>
    </ScrollViewer>
</Window>
