<Window x:Class="AplikacjaNotatek.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aplikacja Notatnik - Wykonał Mateusz Golnau" 
        Height="650" Width="450"
        Background="#F0F8FF">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Notatki" FontSize="24" FontWeight="Bold" Foreground="#0000CD" Margin="0,0,0,10"/>

        <ListView x:Name="ListViewNotatki" Grid.Row="1" Background="White" Margin="0,0,0,15" MinHeight="150">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="5">
                        <TextBlock Text="{Binding Tytul}" FontWeight="Bold" FontSize="16" Foreground="#0000CD"/>
                        <TextBlock Text="{Binding Tresc}" FontSize="14" Foreground="Black" TextWrapping="Wrap"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="2" Text="Dodanie notatki" FontSize="18" FontWeight="Bold" Foreground="#0000CD" Margin="0,5,0,10"/>

        <TextBlock Grid.Row="3" Text="Tytuł notatki:" FontSize="14" Margin="0,0,0,3"/>
        <TextBox x:Name="TxtTytul" Grid.Row="4" FontSize="14" Padding="5" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="5" Text="Treść notatki:" FontSize="14" Margin="0,0,0,3"/>
        <TextBox x:Name="TxtTresc" Grid.Row="6" FontSize="14" Padding="5" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,15"/>

        <Button x:Name="BtnDodaj" Grid.Row="7" Content="DODAJ" Foreground="#0000CD" FontWeight="Bold" FontSize="14" Height="40" Click="BtnDodaj_Click"/>
    </Grid>
</Window>
