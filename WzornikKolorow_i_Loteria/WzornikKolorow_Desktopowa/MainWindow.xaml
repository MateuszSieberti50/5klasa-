<Window x:Class="WzornikKolorow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wzornik kolorów RGB. Wykonał Mateusz Golnau" 
        Height="520" Width="650"
        Background="#FFF8DC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="110"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Border x:Name="DuzyProstokat" Grid.Row="0" Background="White" BorderBrush="DarkGray" BorderThickness="1" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="1" Text="Dobierz kolor suwakami i zapisz przyciskiem:" Margin="0,0,0,15" FontSize="14" FontWeight="SemiBold"/>

        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="R" VerticalAlignment="Center" FontWeight="Bold"/>
            <Slider x:Name="SliderR" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="255" Value="255" TickFrequency="1" IsSnapToTickEnabled="True" Margin="5" ValueChanged="Suwak_ValueChanged"/>
            <TextBlock x:Name="LabelR" Grid.Row="0" Grid.Column="2" Text="255" VerticalAlignment="Center" HorizontalAlignment="Right"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="G" VerticalAlignment="Center" FontWeight="Bold"/>
            <Slider x:Name="SliderG" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" Value="255" TickFrequency="1" IsSnapToTickEnabled="True" Margin="5" ValueChanged="Suwak_ValueChanged"/>
            <TextBlock x:Name="LabelG" Grid.Row="1" Grid.Column="2" Text="255" VerticalAlignment="Center" HorizontalAlignment="Right"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="B" VerticalAlignment="Center" FontWeight="Bold"/>
            <Slider x:Name="SliderB" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" Value="255" TickFrequency="1" IsSnapToTickEnabled="True" Margin="5" ValueChanged="Suwak_ValueChanged"/>
            <TextBlock x:Name="LabelB" Grid.Row="2" Grid.Column="2" Text="255" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <Button x:Name="BtnPobierz" Grid.Row="3" Content="Pobierz" Background="#CD853F" Foreground="Black" Width="180" Height="36" FontSize="14" FontWeight="Bold" Click="BtnPobierz_Click" HorizontalAlignment="Center"/>

        <Border x:Name="MalyProstokat" Grid.Row="4" Background="White" BorderBrush="DarkGray" BorderThickness="1" Margin="0,15,0,0">
            <TextBlock x:Name="TxtPobranyKolor" Text="255, 255, 255" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
        </Border>
    </Grid>
</Window>
