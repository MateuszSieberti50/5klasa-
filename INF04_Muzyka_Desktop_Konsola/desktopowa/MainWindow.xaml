<Window x:Class="MojeDzwiekiApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MojeDźwięki, Wykonał: Mateusz Golnau" 
        Height="350" Width="750"
        Background="#2E8B57"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Button x:Name="BtnPrev" Grid.Column="0" Width="60" Height="70" Click="BtnPrev_Click" VerticalAlignment="Center" Margin="0,0,15,0">
            <Image Source="obraz2.png" Stretch="UniformToFill"/>
        </Button>

        <Image x:Name="ImgPlyta" Grid.Column="1" Width="130" Height="130" Source="obraz.png" VerticalAlignment="Center" Margin="0,0,20,0"/>

        <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock x:Name="TxtWykonawca" Text="Wykonawca" FontSize="50" Foreground="White" FontWeight="Bold"/>
            <TextBlock x:Name="TxtTytul" Text="Tytuł" FontSize="30" Foreground="White" FontStyle="Italic"/>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                <TextBlock x:Name="TxtUtworow" Text="0" FontSize="20" Foreground="#61D918" Margin="0,0,5,0"/>
                <TextBlock Text="utworów" FontSize="20" Foreground="White" Margin="0,0,15,0"/>
                <TextBlock x:Name="TxtRok" Text="0000" FontSize="20" Foreground="#61D918"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <TextBlock x:Name="TxtPobrania" Text="0" FontSize="20" Foreground="#61D918" Margin="0,0,15,0"/>
                <Button x:Name="BtnPobierz" Content="Pobierz" FontSize="20" FontWeight="Bold" Background="#61D918" Foreground="Black" Padding="10,2" Click="BtnPobierz_Click"/>
            </StackPanel>
        </StackPanel>

        <Button x:Name="BtnNext" Grid.Column="3" Width="60" Height="70" Click="BtnNext_Click" VerticalAlignment="Center" Margin="15,0,0,0">
            <Image Source="obraz3.png" Stretch="UniformToFill"/>
        </Button>
    </Grid>
</Window>
