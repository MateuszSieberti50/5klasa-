<Window x:Class="CzcionkiApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Czcionki - Wykonał Mateusz Golnau" 
        Height="550" Width="380"
        Background="White"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">
        <!-- Nagłówek Właściwości czcionki -->
        <Border Background="#558B2F" Padding="12" Margin="0,0,0,20">
            <TextBlock Text="Właściwości czcionki" 
                       Foreground="White" 
                       FontSize="22" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Left"/>
        </Border>

        <!-- Napis Rozmiar: -->
        <TextBlock x:Name="TxtRozmiar" 
                   Text="Rozmiar: 12" 
                   Foreground="Black" 
                   FontSize="16" 
                   Margin="0,0,0,10"/>

        <!-- Suwak (Slider 0..40) -->
        <Slider x:Name="SldRozmiar" 
                Minimum="0" 
                Maximum="40" 
                Value="12" 
                IsSnapToTickEnabled="True" 
                TickFrequency="1" 
                Margin="0,0,0,20" 
                ValueChanged="SldRozmiar_ValueChanged"/>

        <!-- Napis cytatu -->
        <TextBlock x:Name="TxtCytat" 
                   Text="Dzień dobry" 
                   Foreground="Black" 
                   FontSize="12" 
                   TextWrapping="Wrap" 
                   Margin="0,0,0,25"/>

        <!-- Przycisk >> wyśrodkowany z pogrubionym tekstem -->
        <Button x:Name="BtnZmien" 
                Content="&gt;&gt;" 
                Background="#558B2F" 
                Foreground="White" 
                FontWeight="Bold" 
                FontSize="18" 
                Padding="35,8" 
                HorizontalAlignment="Center" 
                BorderThickness="0" 
                Click="BtnZmien_Click"/>
    </StackPanel>
</Window>
