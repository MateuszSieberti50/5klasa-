<Window x:Class="RejestracjaKonta.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rejestracja konta - Wykonał Mateusz Golnau" 
        Height="550" Width="360"
        Background="#F5F5F5"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="0">
        <!-- Nagłówek Rejestruj konto z tłem Teal (#008080) -->
        <Border Background="#008080" Padding="15,12">
            <TextBlock Text="Rejestruj konto" 
                       Foreground="White" 
                       FontSize="24" 
                       FontWeight="Normal"/>
        </Border>

        <StackPanel Margin="15">
            <!-- Podaj e-mail -->
            <TextBlock Text="Podaj e-mail:" Foreground="Black" FontSize="14" Margin="0,10,0,5"/>
            <TextBox x:Name="TxtEmail" FontSize="14" Padding="6" Margin="0,0,0,15"/>

            <!-- Podaj hasło -->
            <TextBlock Text="Podaj hasło:" Foreground="Black" FontSize="14" Margin="0,0,0,5"/>
            <PasswordBox x:Name="TxtHaslo" FontSize="14" Padding="6" Margin="0,0,0,15"/>

            <!-- Powtórz hasło -->
            <TextBlock Text="Powtórz hasło:" Foreground="Black" FontSize="14" Margin="0,0,0,5"/>
            <PasswordBox x:Name="TxtPowtorzHaslo" FontSize="14" Padding="6" Margin="0,0,0,25"/>

            <!-- Przycisk ZATWIERDŹ wyśrodkowany -->
            <Button x:Name="BtnZatwierdz" 
                    Content="ZATWIERDŹ" 
                    Background="#E0E0E0" 
                    Foreground="Black" 
                    FontWeight="Bold" 
                    FontSize="14" 
                    Padding="25,8" 
                    HorizontalAlignment="Center" 
                    Margin="0,0,0,25" 
                    Click="BtnZatwierdz_Click"/>

            <!-- Obszar komunikatów wyśrodkowany -->
            <TextBlock x:Name="TxtKomunikat" 
                       Text="Autor: Mateusz Golnau" 
                       Foreground="Black" 
                       FontSize="16" 
                       HorizontalAlignment="Center" 
                       TextAlignment="Center" 
                       TextWrapping="Wrap"/>
        </StackPanel>
    </StackPanel>
</Window>
